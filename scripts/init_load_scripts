/*

=============================================================================================================
Load Scripts
=============================================================================================================


PURPOSE:
    Load raw data from ERP and CRM CSV files into bronze staging tables. 
    TRUNCATE TABLE is used to guarantee a clean full load by removing all existing rows 
    without generating transaction log overhead.
    BULK INSERT provides a performant load mechanism for flat files, assuming consistent file
    structures and field delimiters.

WARNING:
    ⚠️ Running this script will remove all data currently stored in the target tables.
       Ensure this operation is acceptable before execution, particularly in shared or 
       production environments.
*/

TRUNCATE TABLE bronze.crm_cust_info;

BULK INSERT bronze.crm_cust_info
FROM 'C:\Users\JAB\Desktop\Udemy\SQL\sql-data-warehouse-project\datasets\source_crm\cust_info.csv'
WITH (
    FIRSTROW = 2,
    FIELDTERMINATOR = ',',
    TABLOCK
);


